{
  "schema_version":"KALP-CSD-017-SCENE-SHOT-COMPOSITION-CAMERA-GRAMMAR-1.0",
  "engine_id":"KALP-CSD-017",
  "engine_name":"Scene Shot Composition & Camera Grammar Director",
  "status":"LOCKED",
  "purpose":"Translate each approved dramatic beat into executable shot and camera language while preserving canonical reality, perspective, character identity, blocking, timing and narrative intent.",
  "core_principle":"Camera language expresses the story state; it must never invent or contradict the canonical scene reality.",
  "shot_model":"beat + perspective + blocking + emotional_intent + canonical_state → shot_contract",
  "shot_schema":{
    "required":["shot_id","frame_id","beat_id","shot_type","subject","purpose","camera_position","lens","composition","blocking","eyeline","movement","duration_seconds","transition"],
    "shot_types":["EXTREME_WIDE","WIDE","FULL","MEDIUM_WIDE","MEDIUM","MEDIUM_CLOSE","CLOSE_UP","EXTREME_CLOSE_UP","OVER_SHOULDER","TWO_SHOT","THREE_SHOT","POV","INSERT","CUTAWAY"],
    "movement_types":["STATIC","PUSH_IN","PULL_OUT","DOLLY","TRACK","PAN","TILT","CRANE","ORBIT","HANDHELD","STEADICAM","WHIP_PAN","RACK_FOCUS","NONE"]
  },
  "camera_grammar":{
    "position":["front","rear","left","right","high","low","overhead","character_anchored","world_anchored"],
    "lens_families":["ultra_wide","wide","normal","portrait","telephoto","macro"],
    "composition":["symmetrical","asymmetrical","leading_lines","centered","rule_of_thirds","negative_space","layered_depth","silhouette","foreground_obstruction"],
    "depth":["foreground","subject_plane","background","deep_focus","shallow_focus"],
    "eyeline":["direct","off_axis_left","off_axis_right","down","up","shared_axis","subjective"],
    "continuity_rules":["180_DEGREE_AXIS","EYELINE_MATCH","SCREEN_DIRECTION","SIZE_MATCH","POSITION_MATCH","LENS_CONTINUITY","MOTION_MATCH","LIGHT_DIRECTION_MATCH"]
  },
  "shot_selection_rules":[
    "Shot purpose must map to the assigned CSD-016 beat.",
    "Camera position must be physically reachable within the CSD-011 spatial state.",
    "Lens/composition may shape audience perception but cannot alter physical facts.",
    "Character POV shots must comply with CSD-007 knowledge and CSD-008 perception.",
    "Blocking must preserve CSD-011 character positions and permitted movement.",
    "Eyelines must resolve against actual character orientation and target position.",
    "Camera movement requires a narrative or perceptual purpose.",
    "A shot cannot cross the established axis without an explicit transition or motivated axis reset.",
    "Lighting direction must remain compatible with canonical environment state.",
    "Shot duration must fit within the CSD-016 beat timing contract.",
    "Maximum five active characters remains enforced.",
    "Identity and costume locks remain immutable."
  ],
  "composition_contract":{
    "required":["subject_priority","visual_hierarchy","foreground","midground","background","negative_space_intent","focus_priority"],
    "rule":"Composition must communicate the beat's intended narrative hierarchy without adding unapproved story information."
  },
  "camera_continuity":{
    "state":["axis","screen_direction","camera_side","focal_length_family","movement_state","eyeline_network","lighting_direction"],
    "handoff_rule":"Every shot inherits the previous shot's continuity state unless an explicit motivated transition updates it.",
    "hard_rule":"A camera change cannot silently change character geography."
  },
  "shot_transition_types":["CUT","MATCH_CUT","DISSOLVE","FADE","WIPE","WHIP_TRANSITION","RACK_FOCUS","MOTION_MATCH","CONTINUOUS_MOVE"],
  "camera_pipeline":[
    "LOAD_CSD016_BEAT_MAP",
    "LOAD_CSD011_CANONICAL_SPATIAL_STATE",
    "LOAD_CSD008_PERSPECTIVE_STATE",
    "LOAD_CSD015_FRAME_OBJECTIVE",
    "RESOLVE_SHOT_PURPOSE",
    "RESOLVE_SUBJECT_PRIORITY",
    "RESOLVE_CAMERA_POSITION",
    "RESOLVE_LENS",
    "RESOLVE_COMPOSITION",
    "RESOLVE_BLOCKING_AND_EYELINE",
    "RESOLVE_CAMERA_MOVEMENT",
    "RESOLVE_CONTINUITY_STATE",
    "BIND_SHOT_DURATION",
    "BIND_TRANSITION",
    "VALIDATE_SPATIAL_AND_CAMERA_GRAMMAR",
    "EMIT_CSD002_FRAME_CAMERA_PACKAGE"
  ],
  "validation":{
    "hard_failures":[
      "SHOT_WITHOUT_BEAT",
      "CAMERA_POSITION_PHYSICALLY_IMPOSSIBLE",
      "BLOCKING_CONTRADICTS_CANONICAL_STATE",
      "EYELINE_TARGET_UNRESOLVED",
      "POV_KNOWLEDGE_VIOLATION",
      "AXIS_BREAK_WITHOUT_MOTIVATION",
      "SCREEN_DIRECTION_CONTRADICTION",
      "LIGHT_DIRECTION_CONTRADICTION",
      "SHOT_DURATION_OUTSIDE_BEAT",
      "IDENTITY_LOCK_MUTATION",
      "ACTIVE_CHARACTER_COUNT_ABOVE_5",
      "FRAME_WITHOUT_CAMERA_CONTRACT"
    ],
    "advisories":[
      "REPEATED_SHOT_SIZE",
      "LOW_VISUAL_VARIATION",
      "EXCESSIVE_CAMERA_MOVEMENT",
      "LONG_STATIC_DURATION",
      "FOCAL_LENGTH_JUMP"
    ]
  },
  "output_contract":{
    "shot_map":"ordered shot contracts",
    "camera_continuity_state":"axis, eyeline, screen direction and movement state",
    "composition_contracts":"visual hierarchy for each shot",
    "frame_camera_package":"CSD-002-ready camera package",
    "visual_generation_handoff":"CSD-003-compatible provider-neutral camera specification"
  },
