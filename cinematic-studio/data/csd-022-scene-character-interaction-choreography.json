      {"interaction_id":"I02","sequence":2,"beat_id":"B03","initiator":"RAM_001","receiver":"RAVAN_001","interaction_type":"CHALLENGE","initiator_intent":"hold the boundary without escalation","observable_action":"calm verbal response and stillness","receiver_perception":"Ravan perceives resistance without fear","receiver_reaction":"jaw tightens; breath slows","state_change":"decision pressure increases"},
