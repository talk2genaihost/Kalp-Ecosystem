        "decision":"MASTER_V1.1"
      }
    ],
    "lineage_examples":[
      "HF_F01_PROXY:v1.0 → PROVIDER_PROXY_OF → F01_CANONICAL:v1.0",
      "RAVAN_COSTUME_REFERENCE:v1.1 → REVISION_OF → RAVAN_COSTUME_REFERENCE:v1.0"
    ],
    "rollback_test":{
