        "reference_support":true,
        "camera_control":true,
        "resolution":["1k","2k","4k"],
        "max_concurrency":1,
        "health":"OPERATIONAL"
      }
    ],
    "runtime_state":{
      "HIGGSFIELD/cinematic_studio_2_5":{"available":true,"active_jobs":0,"queue_depth":0,"credits_available":true}
    },
    "result":"ELIGIBLE_ROUTE",
    "route":{
      "provider_id":"HIGGSFIELD",
      "model_id":"cinematic_studio_2_5",
      "route_status":"READY",
      "reason":"All hard capabilities and runtime conditions satisfied."
    }
  },
  "downstream":["CMSE-015-SCHEDULING","CMSE-010-PRODUCTION-EXECUTION"]
}