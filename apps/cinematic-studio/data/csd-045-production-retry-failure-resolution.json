  "retry_controls":{
    "max_attempts":"Must be supplied by governing policy; never invented by the engine.",
    "backoff":"Use bounded exponential or provider-recommended backoff with jitter where supported.",
    "storm_detection":"Escalate when repeated failures cluster without meaningful configuration or provider-state change.",
    "same_configuration":"Allowed only when evidence indicates a transient condition and retry history remains within policy.",
    "configuration_change":"Must be traceable to the failure evidence and remain within approved capability.",
    "new_attempt":"Every retry receives a new attempt_id and immutable dispatch lineage.",
    "idempotency":"Never reuse a completed/unknown provider job identity for a new attempt."
  },
  "retry_budget":{
    "scopes":["JOB","FRAME","SCENE","ARC","UNIVERSE","PROVIDER","MODEL","CAMPAIGN","TIME_WINDOW"],
    "counters":["attempts","retry_attempts","retry_cost","retry_time","consecutive_failures"],
    "policy":"Budget limits come from governance; CSD-045 may consume but never silently increase them."
  },
  "backoff_policy":{
    "states":["IMMEDIATE","SHORT","MEDIUM","LONG","OPERATOR_HOLD"],
    "selection":"Based on failure class, provider health, retry history, queue pressure and supplied provider guidance.",
    "jitter":"Required for clustered retry risk where supported.",
    "no_retry_loop":"A failed retry must re-enter failure classification; it cannot automatically recurse indefinitely."
  },
  "governance":{
    "auto_actions":["CLASSIFY_FAILURE","APPLY_POLICY_BACKOFF","CREATE_RETRY_PROPOSAL","STOP_RETRY_STORM","REASSEMBLE_WITHIN_EXISTING_CONTRACT","UPDATE_LEARNING"],
