  "prediction_outputs":["FAILURE_RISK","EXPECTED_LATENCY","EXPECTED_COST","EXPECTED_SUCCESS_YIELD","RETRY_RISK","QUEUE_RISK","QA_RISK","BUDGET_RISK"],
  "confidence_bands":["LOW","MEDIUM","HIGH"],
  "strategy_actions":["NO_CHANGE","PREWARM_OR_RESERVE_CAPACITY","SEQUENCE_CRITICAL_PATH_FIRST","DEFER_LOW_PRIORITY","REDUCE_CONCURRENCY","INCREASE_CONCURRENCY_WITHIN_LIMIT","ROUTE_TO_APPROVED_ALTERNATIVE","ADJUST_RETRY_BUDGET","REQUEST_OPERATOR_REVIEW"],
