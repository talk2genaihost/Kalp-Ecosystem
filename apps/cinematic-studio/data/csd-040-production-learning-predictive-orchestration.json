    "GOVERNOR_REVIEW":["PREWARM_OR_RESERVE_CAPACITY","ROUTE_TO_APPROVED_ALTERNATIVE"],
    "OPERATOR_REVIEW":["REQUEST_OPERATOR_REVIEW"]
  },
  "prediction_safety":[
    "Predictions must include model/version, evidence window and confidence.",
    "Historical observations are not treated as current provider truth without freshness metadata.",
    "Insufficient evidence yields LOW confidence and cannot silently become execution authority.",
    "Prediction never overrides CSD-037 admission gates.",
    "Prediction never bypasses CSD-032 or CSD-033.",
    "Predicted cost uses supplied current pricing evidence; historical cost is not silently reused as current price.",
    "No strategy may select an unapproved provider.",
    "No strategy may mutate canonical scene or asset masters.",
    "No strategy may activate an inactive narrative branch.",
    "Actual outcomes are retained separately from predictions for calibration."
  ],
  "calibration":{
    "metrics":["failure_risk_brier_or_equivalent","latency_error","cost_error","yield_error","retry_prediction_error"],
    "policy":"Prediction confidence is reduced when recent calibration error increases.",
    "versioning":"Every prediction references the knowledge/model version used."
  },
  "orchestration_record":{
    "required":["orchestration_id","target_job_set","prediction_record_ids","knowledge_version","strategy","confidence","authorization_class","created_at"],
    "immutability":"Issued plans are immutable; revisions create new plans."
