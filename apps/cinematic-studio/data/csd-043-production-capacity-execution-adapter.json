    "creative_gates_unchanged":true
  },
  "downstream":["CSD-031-EXECUTION-LIFECYCLE","CSD-032-RESULT-VALIDATION","CSD-042-CAPACITY-MANAGER","CMSE-014-PROVIDER-ADAPTERS","CMSE-015-PRODUCTION-SCHEDULER","CSD-044-PRODUCTION-EXECUTION-RECONCILIATION-AND-RESILIENCE"]
}