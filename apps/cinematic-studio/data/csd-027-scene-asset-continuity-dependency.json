  "downstream":["CSD-002-8-FRAME-DIRECTOR","CSD-003-PERSPECTIVE-TO-VISUAL-GENERATION","CMSE-010-PRODUCTION-ORCHESTRATOR","CMSE-011-ASSET-MEMORY","CMSE-012-PRODUCTION-RETRIEVAL","CMSE-013-PROMPT-COMPILER","CMSE-014-PROVIDER-ROUTING","CMSE-015-SCHEDULER"]
}