      "sequence":4,
      "actor":"RAVAN_001",
      "event_type":"DECISION",
      "action":"chooses restraint after Rama's controlled challenge",
      "intent":"demonstrate mastery without escalation",
      "preconditions":["RAVAN_POWER_ACTIVE","RAMA_CHALLENGE_ACTIVE"],
      "observable_effects":["power intensity remains contained","Ravana lowers aggressive posture"],
      "hidden_consequences":["Ravana begins questioning whether restraint is a higher form of mastery"],
      "causal_effects":["CHARACTER_STATE","RELATIONSHIP_STATE","ENVIRONMENT_STATE"],
      "state_deltas":[
        {"delta_id":"D01","event_id":"E04","domain":"character","path":"RAVAN_001.current_emotion","before":"high_controlled_intensity","after":"controlled_introspection","causal_basis":"E04"},
        {"delta_id":"D02","event_id":"E04","domain":"relationship","path":"RAM_001↔RAVAN_001.tension","before":"high","after":"high_but_non_escalating","causal_basis":"E04"},
        {"delta_id":"D03","event_id":"E04","domain":"environment","path":"power_field.intensity","before":"elevated","after":"contained","causal_basis":"E04"}
      ]
    },
    "result":{
      "status":"ACCEPTED",
      "new_version":"1.1",
      "parent_preserved_as":"SUPERSEDED",
      "continuity_validation":"PASS",
      "causal_graph":"ACYCLIC",
      "downstream_ready":true
    }
  },
  "downstream":["CSD-006-CHARACTER-STATE","CSD-007-KNOWLEDGE-STATE","CSD-008-PERSPECTIVE","CSD-009-PERCEPTION-VALIDATION","CSD-010-ORCHESTRATOR","CSD-002-8-FRAME-DIRECTOR","CMSE-002-CONTINUITY"]
}