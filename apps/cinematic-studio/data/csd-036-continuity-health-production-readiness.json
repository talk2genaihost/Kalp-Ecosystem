    "HIGH":["LINEAGE_BREAK","CROSS_SCENE_CONTINUITY_FAILURE","ORPHAN_JOB","SUPERSEDED_ACTIVE_DEPENDENCY"],
    "MEDIUM":["QA_WARNING","RECOVERY_WARNING","NON_CRITICAL_ASSET_DRIFT","EXECUTION_DEGRADATION"],
    "LOW":["PRESENTATION_METADATA_DRIFT"]
  },
  "health_record":{
    "required":["health_snapshot_id","timestamp","scope","domain_status","health_score","health_state","readiness_state","blocking_issues","warnings","evidence","computed_from"],
    "immutability":"Each health snapshot is immutable; a new observation creates a new snapshot."
  },
  "production_readiness_actions":{
    "READY_FOR_PRODUCTION":"Authorize eligible production jobs.",
    "CONDITIONAL_READY":"Allow only explicitly eligible jobs; preserve warnings.",
    "NOT_READY":"Block new dependent production.",
    "PRODUCTION_LOCKED":"Freeze readiness snapshot and issue execution authorization."
