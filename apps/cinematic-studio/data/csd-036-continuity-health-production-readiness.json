  "health_transitions":[
    "UNKNOWN→HEALTHY",
    "HEALTHY→DEGRADED",
    "HEALTHY→BLOCKED",
    "DEGRADED→RECOVERING",
    "RECOVERING→HEALTHY",
    "RECOVERING→DEGRADED",
    "RECOVERING→BLOCKED",
    "BLOCKED→RECOVERING",
    "DEGRADED→HEALTHY"
  ],
  "alert_classes":{
